{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "packageRules": [
    {
      "description": "Offer each major separately instead of jumping to the latest. Nextcloud supports upgrading one major version at a time",
      "matchManagers": [
        "docker-compose"
      ],
      "separateMultipleMajor": true
    },
    {
      "description": "Group all non-major container image updates into one PR",
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "container images"
    }
  ]
}
