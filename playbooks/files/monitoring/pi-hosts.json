{
 "uid": "homelab-pis",
 "title": "Pi hosts",
 "tags": [
  "homelab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "query": {
     "query": "label_values(up{job=\"node\"}, host)",
     "refId": "q"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Status",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "up{job=\"node\",host=~\"$host\"}",
     "legendFormat": "{{host}}",
     "instant": true,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "justifyMode": "center"
   }
  },
  {
   "type": "stat",
   "title": "CPU",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 3,
    "y": 1
   },
   "targets": [
    {
     "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\",host=~\"$host\"}[2m])) * 100",
     "legendFormat": "{{host}}",
     "instant": true,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "justifyMode": "center"
   }
  },
  {
   "type": "stat",
   "title": "Memory",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "expr": "(1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}) * 100",
     "legendFormat": "{{host}}",
     "instant": true,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
