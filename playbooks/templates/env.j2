# MariaDB Configuration
MYSQL_DATABASE={{ mysql_database }}
MYSQL_PASSWORD={{ mysql_password }}
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_USER={{ mysql_user }}

# Redis Configuration
REDIS_PASSWORD={{ mysql_password }}

# Nextcloud Configuration
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
NEXTCLOUD_BASE_DIR={{ nextcloud_base_dir }}
NEXTCLOUD_PORT={{ nextcloud_port }}
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_domain }}

# General
TIMEZONE={{ timezone }}

{% if with_proxy | bool %}
# Nginx Proxy Manager Configuration
NGINX_ADMIN_EMAIL={{ nginx_admin_email }}
NGINX_ADMIN_PASSWORD={{ nginx_admin_password }}

{% endif %}
# Volume Paths
MARIADB_DATA_DIR={{ mariadb_data_dir }}
NETDATA_DATA_DIR={{ netdata_data_dir }}
NEXTCLOUD_DATA_DIR={{ nextcloud_data_dir }}
NGINX_DATA_DIR={{ nginx_data_dir }}
REDIS_DATA_DIR={{ redis_data_dir }}
