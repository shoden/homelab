# Sends the alerts of vmalert to Telegram.
route:
  receiver: telegram
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: {{ telegram_chat_id }}
        send_resolved: true
        message: |
          {% raw %}{{ range .Alerts }}{{ if eq .Status "firing" }}🔥 {{ .Labels.severity | toUpper }}{{ else }}✅ RESOLVED{{ end }} {{ .Labels.alertname }}
          {{ .Annotations.summary }}
          {{ end }}{% endraw %}
