version: '3.8'

services:
  mariadb:
    image: mariadb:13.0.2
    container_name: {{ container_db }}
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW
    volumes:
      - ${MARIADB_DATA_DIR}:/var/lib/mysql
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 3s
    networks:
      - nextcloud-network

  redis:
    image: redis:8.10.3-alpine
    container_name: {{ container_redis }}
    restart: unless-stopped
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - ${REDIS_DATA_DIR}:/data
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 3s
    networks:
      - nextcloud-network

  nextcloud:
    image: nextcloud:35.0.3-apache
    container_name: {{ container_app }}
    restart: unless-stopped
    volumes:
      - ${NEXTCLOUD_DATA_DIR}:/var/www/html
      - ${NEXTCLOUD_BASE_DIR}/apache-hsts.conf:/etc/apache2/conf-enabled/hsts.conf:ro
    environment:
      - MYSQL_HOST=mariadb
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - REDIS_HOST=redis
      - REDIS_HOST_PASSWORD=${REDIS_PASSWORD}
      - NEXTCLOUD_ADMIN_USER=${NEXTCLOUD_ADMIN_USER}
      - NEXTCLOUD_ADMIN_PASSWORD=${NEXTCLOUD_ADMIN_PASSWORD}
      - NEXTCLOUD_TRUSTED_DOMAINS=${NEXTCLOUD_TRUSTED_DOMAINS}
      - OVERWRITEPROTOCOL=https
      - OVERWRITEHOST=${NEXTCLOUD_TRUSTED_DOMAINS}
      - TRUSTED_PROXIES=172.16.0.0/12
      - APACHE_DISABLE_REWRITE_IP=1
      - APACHE_SERVERNAME=${NEXTCLOUD_TRUSTED_DOMAINS}
    depends_on:
      mariadb:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      # Healthy only once Apache serves status.php. The image starts Apache after it has copied the new
      # code and run `occ upgrade` (minutes after an image bump), whereas `occ status` already works
      # before that. start_period covers a long upgrade without counting it as a failure.
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost/status.php"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 600s
    networks:
      - nextcloud-network
{% if with_proxy | bool %}
  nginx:
    image: 'jc21/nginx-proxy-manager:2.17.1'
    container_name: {{ container_proxy }}
    restart: unless-stopped
    ports:
      # These ports are in format <host-port>:<container-port>
      - '80:80' # Public HTTP Port
      - '443:443' # Public HTTPS Port
      - '81:81' # Admin Web Port
      # Add any other Stream port you want to expose
      # - '21:21' # FTP
    environment:
      - TZ=${TIMEZONE}
      - DB_MYSQL_HOST=mariadb
      - DB_MYSQL_PORT=3306
      - DB_MYSQL_USER=${MYSQL_USER} 
      - DB_MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - DB_MYSQL_NAME=${MYSQL_DATABASE}
      - DISABLE_IPV6='true'
      - INITIAL_ADMIN_EMAIL=${NGINX_ADMIN_EMAIL}
      - INITIAL_ADMIN_PASSWORD=${NGINX_ADMIN_PASSWORD}
    volumes:
      - ${NGINX_DATA_DIR}/data:/data
      - ${NGINX_DATA_DIR}/letsencrypt:/etc/letsencrypt
    depends_on:
      - mariadb
    networks:
      - nextcloud-network
{% endif %}
{% if with_node_exporter | bool %}

  node-exporter:
    image: prom/node-exporter:v1.13.1
    container_name: {{ container_node_exporter }}
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address=${NODE_EXPORTER_LISTEN}
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+|var/lib/containers/.+)($$|/)
    volumes:
      - /:/host:ro,rslave
{% endif %}
{% if with_monitoring_hub | bool %}

  victoria-metrics:
    image: victoriametrics/victoria-metrics:v1.157.0
    container_name: {{ container_metrics }}
    restart: unless-stopped
    command:
      - -storageDataPath=/storage
      - -retentionPeriod=${MONITORING_RETENTION}
      - -promscrape.config=/etc/victoria/scrape.yml
      - -memory.allowedPercent=20
    volumes:
      - ${MONITORING_DIR}/vm-data:/storage
      - ${MONITORING_DIR}/scrape.yml:/etc/victoria/scrape.yml:ro
    networks:
      - nextcloud-network

  alertmanager:
    image: prom/alertmanager:v0.35.0
    container_name: {{ container_alertmanager }}
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    volumes:
      - ${MONITORING_DIR}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ${MONITORING_DIR}/alertmanager-data:/alertmanager
    networks:
      - nextcloud-network

  vmalert:
    image: victoriametrics/vmalert:v1.157.0
    container_name: {{ container_vmalert }}
    restart: unless-stopped
    command:
      - -datasource.url=http://victoria-metrics:8428
      - -notifier.url=http://alertmanager:9093
      - -rule=/etc/vmalert/alerts.yml
      - -evaluationInterval=30s
    volumes:
      - ${MONITORING_DIR}/alerts.yml:/etc/vmalert/alerts.yml:ro
    depends_on:
      - victoria-metrics
      - alertmanager
    networks:
      - nextcloud-network

  grafana:
    image: grafana/grafana:13.3.1
    container_name: {{ container_grafana }}
    restart: unless-stopped
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_SERVER_ROOT_URL=https://${GRAFANA_DOMAIN}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
      - GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
      - GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana-dashboards/pi-hosts.json
      - GF_INSTALL_PLUGINS=victoriametrics-logs-datasource
      - LOGS_USER=${LOGS_USER}
      - LOGS_PASSWORD=${LOGS_INGEST_PASSWORD}
    volumes:
      - ${MONITORING_DIR}/grafana-data:/var/lib/grafana
      - ${MONITORING_DIR}/provisioning:/etc/grafana/provisioning:ro
      - ${MONITORING_DIR}/dashboards:/var/lib/grafana-dashboards:ro
    depends_on:
      - victoria-metrics
      - victoria-logs
    networks:
      - nextcloud-network

  # Logs of every host (see the shippers below). Published on the LAN (logs_listen) for the other hosts' shippers;
  # Grafana queries it over the internal network. Both use TLS (logs_tls) and the basic auth below.
  victoria-logs:
    image: victoriametrics/victoria-logs:v1.54.0
    container_name: {{ container_logs }}
    restart: unless-stopped
    command:
      - -envflag.enable
      - -storageDataPath=/vlogs
      - -retentionPeriod=${LOGS_RETENTION}
      - -retention.maxDiskSpaceUsageBytes=${LOGS_MAX_DISK}
{% if logs_tls | bool %}
      - -tls
      - -tlsCertFile=/tls/server.crt
      - -tlsKeyFile=/tls/server.key
{% endif %}
    environment:
      - httpAuth_username=${LOGS_USER}
      - httpAuth_password=${LOGS_INGEST_PASSWORD}
    volumes:
      - ${MONITORING_DIR}/vlogs-data:/vlogs
{% if logs_tls | bool %}
      - ${MONITORING_DIR}/tls:/tls:ro
{% endif %}
    ports:
      - '${LOGS_LISTEN}:9428'
    networks:
      - nextcloud-network
{% endif %}
{% if with_log_shipper | bool %}

  # Read-only view of the Docker API (container list and logs only), so Vector does not get the full socket.
  # It sits on an internal network that only Vector joins: other containers cannot reach it (container
  # inspect would reveal their environment, passwords included).
  docker-proxy:
    image: tecnativa/docker-socket-proxy:3.4
    container_name: {{ container_docker_proxy }}
    restart: unless-stopped
    environment:
      - CONTAINERS=1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - logs-network

  vector:
    image: timberio/vector:0.62.0-debian
    container_name: {{ container_vector }}
    restart: unless-stopped
    command: ["--config", "/etc/vector/vector.yaml"]
    volumes:
      - ${NEXTCLOUD_BASE_DIR}/vector.yaml:/etc/vector/vector.yaml:ro
      - ${LOG_SHIPPER_DIR}:/var/lib/vector
      - /etc/machine-id:/etc/machine-id:ro
{% for journal_dir in log_journal_dirs %}
      - {{ journal_dir }}:{{ journal_dir }}:ro
{% endfor %}
    depends_on:
      - docker-proxy
    networks:
      - nextcloud-network
      - logs-network
{% endif %}

networks:
  nextcloud-network:
    driver: bridge
{% if with_log_shipper | bool %}
  logs-network:
    driver: bridge
    internal: true
{% endif %}

volumes:
  nextcloud-data:
  mariadb-data:
  redis-data:
  nginx-data:
